{
  "expo": {
    "name": "Drepadata",
    "slug": "drepadata",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/drepa.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/drepa.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.rork.drepadata"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/drepa.png",
        "backgroundColor": "#ffffff"
      },
      "package": "app.rork.drepadata",
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "INTERNET"
      ],
      "networkSecurityConfig": {
        "domain-config": [
          {
            "domain": ["10.238.128.96"],
            "cleartextTrafficPermitted": true
          }
        ]
      }
    },
    "web": {
      "favicon": "./assets/images/drepa.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://rork.com/"
        }
      ]
    ],
    "web": {
      "build": {
        "babel": {
          "include": [
            "@babel/plugin-proposal-export-namespace-from"
          ]
        }
      }
    },
    "packagerOpts": {
      "config": "metro.config.js",
      "sourceExts": [
        "expo.ts",
        "expo.tsx",
        "expo.js",
        "expo.jsx",
        "ts",
        "tsx",
        "js",
        "jsx",
        "json",
        "wasm",
        "svg"
      ]
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "http://localhost:4000/api"
    }
  }
}